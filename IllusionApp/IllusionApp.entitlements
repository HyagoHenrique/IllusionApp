<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Disable sandbox so ScreenCaptureKit can access other apps' content -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Required for ScreenCaptureKit on macOS 14+ -->
    <key>com.apple.security.screen-capture</key>
    <true/>
    <!-- macOS 26 Tahoe: Allow system content access for SCK process enumeration -->
    <key>com.apple.security.system-content</key>
    <true/>
    <!-- Allow access to other apps' windows and content -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
